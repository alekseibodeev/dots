/**
 * Base16 Rosé Pine ROFI Color theme
 *
 * Authors
 *  Scheme: Emilia Dunfelt &lt;edun@dunfelt.se&gt;
 *  Template: Tinted Theming (https://github.com/tinted-theming)
 */

* {
    red:                         rgba ( 235, 111, 146, 100 % );
    blue:                        rgba ( 196, 167, 231, 100 % );
    lightfg:                     rgba ( 224, 222, 244, 100 % );
    lightbg:                     rgba ( 31, 29, 46, 100 % );
    foreground:                  rgba ( 224, 222, 244, 100 % );
    background:                  rgba ( 25, 23, 36, 100 % );
    background-color:            rgba ( 25, 23, 36, 0 % );
}
