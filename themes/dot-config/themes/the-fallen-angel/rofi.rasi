/**
 * Base16 Grayscale Light ROFI Color theme
 *
 * Authors
 *  Scheme: Alexandre Gavioli (https://github.com/Alexx2/)
 *  Template: Tinted Theming (https://github.com/tinted-theming)
 */

* {
    red:                         rgba ( 124, 124, 124, 100 % );
    blue:                        rgba ( 104, 104, 104, 100 % );
    lightfg:                     rgba ( 37, 37, 37, 100 % );
    lightbg:                     rgba ( 227, 227, 227, 100 % );
    foreground:                  rgba ( 70, 70, 70, 100 % );
    background:                  rgba ( 247, 247, 247, 100 % );
    background-color:            rgba ( 247, 247, 247, 0 % );
}
